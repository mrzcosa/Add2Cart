# Copy this file to .env and edit values for your local/deployment environment.
API_PORT=4179
DATA_DIR=./server/data

# Exact frontend origins allowed to call the API with cookies. Keep production origins explicit.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# Comma-separated administrator account emails. Register these accounts, then sign in.
ADMIN_EMAILS=

# Leave empty for the Vite /api proxy. For a separate API host, set its public base URL
# and include the frontend origin above. Never put secrets in VITE_ variables.
VITE_API_BASE_URL=
